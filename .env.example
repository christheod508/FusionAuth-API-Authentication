# Αντέγραψε το σε .env και βάλε δικές σου τοπικές τιμές.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_USER=fusionauth
DATABASE_PASSWORD=replace-with-local-fusionauth-password

FUSIONAUTH_APP_KICKSTART_FILE=/usr/local/fusionauth/kickstart/kickstart.json
FUSIONAUTH_APP_MEMORY=512M
FUSIONAUTH_APP_RUNTIME_MODE=development
FUSIONAUTH_SEARCH_TYPE=elasticsearch
FUSIONAUTH_LOCAL_KICKSTART_DIRECTORY=./kickstart
FUSIONAUTH_LOCAL_PLUGIN_DIRECTORY=./plugins
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Προαιρετικές υπηρεσίες
CLEANSPEAK_APP_MEMORY=512M
CLEANSPEAK_LICENSE_ID=replace-if-licensed
OPENTELEMETRY_COLLECTOR_CONFIG_FILE=./config/opentelemetry-collector.yml
PROMETHEUS_CONFIG_FILE=./config/prometheus.yml
PROMETHEUS_RULES_FILE=./config/prometheus-rules.yml
ALERTMANAGER_CONFIG_FILE=./config/alertmanager.yml

# Replace this placeholder with a unique random value before starting Kickstart.
FUSIONAUTH_API_KEY=replace-with-a-random-local-api-key
